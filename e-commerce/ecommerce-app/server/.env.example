# Copy this file to ".env" and fill in the values.
# Never commit your real .env file.

# Port the API listens on
PORT=5000

# MongoDB connection string
#   Local MongoDB:  mongodb://127.0.0.1:27017/shopsphere
#   MongoDB Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/shopsphere
MONGO_URI=

# Long random string used to sign login tokens (JWT).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# URL of the React app (allowed by CORS). Separate several URLs with commas.
CLIENT_URL=http://localhost:5173

# Optional
# JWT_EXPIRES_IN=7d
# NODE_ENV=development
